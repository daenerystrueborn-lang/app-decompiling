# Server
PORT=3000
HOST=0.0.0.0
# Optional Render/Paas keep-alive ping (uses RENDER_EXTERNAL_URL or SELF_PING_URL)
ENABLE_KEEPALIVE=false
SELF_PING_URL=
SELF_PING_INTERVAL_MS=840000

# Signing secret for /api/proxy/* tokens (change in production!)
PROXY_SECRET=change-me-to-a-long-random-secret
PROXY_ALLOW_UNSIGNED_DEV=true

# AniFam API config (from Anifam v0.2.9)
ANIFAM_PRIMARY_HOST=https://app.anifam.net
ANIFAM_FAILOVER_DOMAINS=https://anifam.net,https://anifam.buzz,https://anifam.top,https://anifam.cfd
ANIFAM_APP_VERSION=20
ANIFAM_APP_PLATFORM=android
ANIFAM_BEARER_TOKEN=

# MiruDL config (from MiruDL v2.2.1)
MIRUDL_ANILAB_API=https://anilab2.amdapi.click/api
MIRUDL_KYOTO_API=https://api.kyotoplayer.com
MIRUDL_KYOTO_MIN_GAP_MS=1500
MIRUDL_DEFAULT_LANGUAGE=jpn

# Downloader defaults
DOWNLOAD_DIR=./downloads
DOWNLOAD_CONCURRENCY=16
DEFAULT_PREFERRED_QUALITY=1080p
